# ---- Geral ----
PORT=3000
BASE_URL=https://revendia.com.br          # URL pública (webhooks, OAuth e imagens do Instagram)
APP_SECRET=troque-por-uma-chave-longa-e-aleatoria   # cifra credenciais das integrações (AES-256-GCM)
TZ_REVENDA=America/Sao_Paulo
# DEMO=1 liga simulações (fornecedor, motoboy, Instagram, pagamentos) quando não há credenciais reais
DEMO=1

# ---- IA (Claude) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Assinatura da plataforma (Mercado Pago: PIX e cartão) ----
MERCADOPAGO_ACCESS_TOKEN=
PRECO_MENSAL=79.90
PRECO_ANUAL=799.00

# ---- WhatsApp Business Platform (Cloud API) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=          # número oficial da RevendIA (OTP, lista diária, avisos)
WHATSAPP_VERIFY_TOKEN=revendia-webhook
WHATSAPP_TEMPLATE_OTP=codigo_verificacao   # template de autenticação aprovado na Meta
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=  # cadastro incorporado: conecta o WhatsApp Business da revendedora

# ---- Instagram (Instagram API com login do Instagram) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Motoboy (Lalamove API v3) ----
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_MARKET=BR
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com
